<ui:FluentWindow x:Class="NetworkAutoSwitch.Tray.Fluent.FluentSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Network Auto Switch" Width="900" Height="720" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica" WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Network Auto Switch"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,8,32,16" MaxWidth="820">
                <ui:TextBlock Text="Settings" FontTypography="Title" Margin="0,0,0,16"/>

                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon PaintBrush24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock Text="Appearance" FontTypography="BodyStrong"/>
                            <ui:TextBlock Text="Follow System switches with Windows' own light/dark setting." Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox x:Name="ThemeBox" Width="220" SelectedIndex="0">
                        <ComboBoxItem Content="Follow System"/>
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="Dark"/>
                    </ComboBox>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ArrowSwap24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock Text="Switching Back" FontTypography="BodyStrong"/>
                            <ui:TextBlock TextWrapping="Wrap" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="Seconds the main connection must work, without a single failed check, before moving back from the backup. Going to the backup is not affected."/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:NumberBox ClearButtonEnabled="False" x:Name="RecoverBox" Minimum="3" Maximum="600" SmallChange="1" MaxDecimalPlaces="0" Width="220" PlaceholderText="Seconds"/>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon AlertOff24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock Text="Mute Notifications" FontTypography="BodyStrong"/>
                            <ui:TextBlock TextWrapping="Wrap" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="Hides the tray pop-ups. Everything is still written to the Log."/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <Grid Width="220"><ui:ToggleSwitch x:Name="MuteSwitch" HorizontalAlignment="Left"/></Grid>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ArrowDownload24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock Text="Global Trigger: Amount" FontTypography="BodyStrong"/>
                            <ui:TextBlock TextWrapping="Wrap" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="Megabytes a watched program may receive on the backup within the time below before it is blocked."/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:NumberBox x:Name="MbBox" ClearButtonEnabled="False" Minimum="0.1" Maximum="10000" SmallChange="0.5" Width="220" PlaceholderText="MB"/>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Timer24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock Text="Global Trigger: Time Window" FontTypography="BodyStrong"/>
                            <ui:TextBlock TextWrapping="Wrap" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="Seconds over which the amount above is measured. A blocked program stays blocked until you unblock it."/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:NumberBox x:Name="SecBox" ClearButtonEnabled="False" Minimum="1" Maximum="600" SmallChange="1" MaxDecimalPlaces="0" Width="220" PlaceholderText="Seconds"/>
                </ui:CardControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="32,12" Background="{ui:ThemeResource ControlFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal">
                <ui:Button x:Name="SaveBtn" Content="Save" Appearance="Primary" Icon="{ui:SymbolIcon Save24}"/>
                <ui:Button x:Name="RevertBtn" Content="Revert" Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowUndo24}"/>
                <ui:TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
