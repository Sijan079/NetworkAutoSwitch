<ui:FluentWindow x:Class="NetworkAutoSwitch.Tray.Fluent.FluentConnectionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Choose Connections" Width="560" Height="360" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Choose Connections" ShowMinimize="False" ShowMaximize="False"/>
        <StackPanel Grid.Row="1" Margin="28,12,28,0">
            <ui:TextBlock Text="Main Connection" FontTypography="BodyStrong" Margin="0,0,0,6"/>
            <ComboBox x:Name="MainBox" HorizontalAlignment="Stretch" ToolTip="The connection you normally use."/>
            <ui:TextBlock Text="Backup Connection" FontTypography="BodyStrong" Margin="0,18,0,6"/>
            <ComboBox x:Name="BackupBox" HorizontalAlignment="Stretch" ToolTip="The connection to fall back on, usually your phone. Automatic keeps looking: a phone plugged in later is picked up."/>
            <ui:TextBlock x:Name="Problem" Margin="0,12,0,0" Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="28,12">
            <ui:Button x:Name="SaveBtn" Content="Save" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" IsDefault="True"/>
            <ui:Button x:Name="CancelBtn" Content="Cancel" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
