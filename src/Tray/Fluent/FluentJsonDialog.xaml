<ui:FluentWindow x:Class="NetworkAutoSwitch.Tray.Fluent.FluentJsonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Edit As JSON" Width="760" Height="600" MinWidth="560" MinHeight="400" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Edit As JSON" ShowMinimize="False" ShowMaximize="False"/>
        <ui:TextBlock Grid.Row="1" Margin="24,8,24,8" Text="The same rules as the Policy page, as text. It is checked when you click Apply." Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
        <TextBox x:Name="Editor" Grid.Row="2" Margin="24,0" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="13"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
        <Grid Grid.Row="3" Margin="24,12,24,16">
            <ui:TextBlock x:Name="Problem" VerticalAlignment="Center" Margin="0,0,200,0" TextWrapping="Wrap" Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="ApplyBtn" Content="Apply" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}"/>
                <ui:Button x:Name="CancelBtn" Content="Cancel" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
