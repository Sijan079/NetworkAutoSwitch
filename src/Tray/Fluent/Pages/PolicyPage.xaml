<Page x:Class="NetworkAutoSwitch.Tray.Fluent.Pages.PolicyPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:f="clr-namespace:NetworkAutoSwitch.Tray.Fluent"
        Title="Policy" Foreground="{DynamicResource TextFillColorPrimaryBrush}" AllowDrop="True">
    <Page.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ui:ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="ui:TextBlock">
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
    </Page.Resources>
    <Grid Margin="32,8,32,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ui:TextBlock Grid.Row="0" Text="Policy" FontTypography="Title" Margin="0,0,0,12"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- rules -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="TextBulletListLtr24" FontSize="18" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            <ui:TextBlock Text="Rules" FontTypography="BodyStrong" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button x:Name="RemoveBtn" Icon="{ui:SymbolIcon Delete24}" ToolTip="Remove the selected rule" Margin="0,0,6,0"/>
                            <ui:Button x:Name="AddBtn" Content="Add Rule" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" ToolTip="Add a rule: pick programs from a list. You can also drag an .exe onto this page."/>
                        </StackPanel>
                    </Grid>
                    <ui:ListView x:Name="RuleList" Grid.Row="1" SelectionMode="Single">
                        <ui:ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,4">
                                    <TextBlock Text="{Binding Display}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ui:ListView.ItemTemplate>
                    </ui:ListView>
                </Grid>
            </Border>

            <!-- the selected rule -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="Form">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="18" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                <ui:TextBlock Text="Rule" FontTypography="BodyStrong" Margin="10,0,0,0"/>
                            </StackPanel>

                            <ui:TextBlock Grid.Row="1" Text="Name" Style="{StaticResource FieldLabel}"/>
                            <ui:TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"/>

                            <ui:TextBlock Grid.Row="2" Text="Type" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="TypeBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                      ToolTip="Watch: blocked only while it downloads fast.&#10;Always block: never allowed on the backup.&#10;Limit uploads: caps upload speed (cannot limit downloads).">
                                <ComboBoxItem Content="Watch Downloads"/><ComboBoxItem Content="Always Block"/><ComboBoxItem Content="Limit Uploads"/>
                            </ComboBox>

                            <ui:TextBlock x:Name="ExesLbl" Grid.Row="3" Text="Programs" Style="{StaticResource FieldLabel}"/>
                            <StackPanel x:Name="ExesPanel" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                                <ui:TextBox x:Name="ExesBox" AcceptsReturn="True" Height="110" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                            ToolTip="One file name per line, e.g. steam.exe.&#10;List launchers and downloaders, never the games, so a game is never cut off."/>
                                <ui:Button x:Name="ChooseExesBtn" Content="Choose Programs" Icon="{ui:SymbolIcon Add24}" Margin="0,8,0,0" ToolTip="Pick programs from a list (or browse for a file)."/>
                            </StackPanel>

                            <ui:TextBlock x:Name="FolderLbl" Grid.Row="4" Text="Folder" Style="{StaticResource FieldLabel}"/>
                            <ui:TextBox x:Name="FolderBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" ToolTip="Optional: only match programs inside this folder (useful when two launchers share a file name)."/>

                            <ui:TextBlock x:Name="PathLbl" Grid.Row="5" Text="Program" Style="{StaticResource FieldLabel}"/>
                            <Grid x:Name="PathPanel" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="PathBox"/>
                                <ui:Button x:Name="ChoosePathBtn" Grid.Column="1" Content="Choose" Icon="{ui:SymbolIcon Folder24}" Margin="8,0,0,0"/>
                            </Grid>

                            <ui:TextBlock x:Name="TriggerLbl" Grid.Row="6" Text="Trigger" Style="{StaticResource FieldLabel}"/>
                            <StackPanel x:Name="TriggerPanel" Grid.Row="6" Grid.Column="1" Margin="0,0,0,10">
                                <ui:ToggleSwitch x:Name="UseGlobal" Content="Use Global Trigger" IsChecked="True" ToolTip="Off = this rule gets its own trigger."/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <f:Stepper x:Name="MbStepper" Minimum="0.1" Maximum="10000" Step="0.5" Decimals="1" Placeholder="MB"/>
                                    <ui:TextBlock x:Name="MbWindowLbl" Text="MB within 10 s" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <ui:TextBlock x:Name="CapLbl" Grid.Row="7" Text="Upload Cap" Style="{StaticResource FieldLabel}"/>
                            <StackPanel x:Name="CapPanel" Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <f:Stepper x:Name="KbpsStepper" Minimum="1" Maximum="1000000" Step="100" Decimals="0" Placeholder="kbps"/>
                                <ui:TextBlock Text="kbps" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    <ui:TextBlock x:Name="EmptyHint" Text="No rules yet. Click Add Rule, or drag an .exe onto this page." HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                                  Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="-32,12,-32,0" Padding="32,12" Background="{ui:ThemeResource ControlFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal">
                <ui:Button x:Name="SaveBtn" Content="Save" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" ToolTip="Check everything, save it and apply it now."/>
                <ui:Button x:Name="RevertBtn" Content="Revert" Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowUndo24}" ToolTip="Discard unsaved changes."/>
                <ui:Button x:Name="JsonBtn" Content="Edit As JSON" Margin="8,0,0,0" Icon="{ui:SymbolIcon Code24}" ToolTip="Edit the same rules as text (for advanced use). Nothing is saved until you click Save."/>
                <ui:TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
