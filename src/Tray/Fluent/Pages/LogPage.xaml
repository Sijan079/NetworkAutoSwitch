<Page x:Class="NetworkAutoSwitch.Tray.Fluent.Pages.LogPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Log" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="32,8,32,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <ui:TextBlock Text="Log" FontTypography="Title"/>
                <ui:TextBlock Text="Newest line first. Select rows and press Ctrl+C to copy." Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:Button x:Name="OpenBtn" Content="Open File" Icon="{ui:SymbolIcon Open24}" ToolTip="Open the log file in Notepad (newest first)."/>
                <ui:Button x:Name="ReloadBtn" Content="Reload" Icon="{ui:SymbolIcon ArrowClockwise24}" Margin="8,0,0,0" ToolTip="Reload the history from the file."/>
                <ui:Button x:Name="ClearBtn" Content="Clear" Icon="{ui:SymbolIcon Delete24}" Margin="8,0,0,0" ToolTip="Clear this view (the file is kept)."/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" CornerRadius="8" BorderThickness="1" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="4">
            <ui:DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="None" GridLinesVisibility="None" CanUserAddRows="False"
                         SelectionMode="Extended" SelectionUnit="FullRow" RowHeaderWidth="0" Background="Transparent" BorderThickness="0" RowHeight="30"
                         VirtualizingPanel.IsVirtualizing="True" FontFamily="Consolas" FontSize="12.5">
                <ui:DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Switch"><Setter Property="Background" Value="#33F59E0B"/></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Block"><Setter Property="Background" Value="#33EF4444"/></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Unblock"><Setter Property="Background" Value="#3322C55E"/></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Info"><Setter Property="Background" Value="#333B82F6"/></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Error"><Setter Property="Background" Value="#66DC2626"/></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Command"><Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:DataGrid.RowStyle>
                <ui:DataGrid.Columns>
                    <DataGridTextColumn Width="190" Binding="{Binding Time}"/>
                    <DataGridTextColumn Width="90" Binding="{Binding Tag}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding Message}"/>
                </ui:DataGrid.Columns>
            </ui:DataGrid>
        </Border>
    </Grid>
</Page>
