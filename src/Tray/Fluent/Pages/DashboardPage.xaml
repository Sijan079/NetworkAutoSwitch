<Page x:Class="NetworkAutoSwitch.Tray.Fluent.Pages.DashboardPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:f="clr-namespace:NetworkAutoSwitch.Tray.Fluent"
        Title="Dashboard">
    <Page.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ui:ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,8,32,24" MaxWidth="980">

            <!-- banner -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Grid.Column="0" MinHeight="44">
                    <StackPanel Orientation="Horizontal" x:Name="BannerRow">
                        <ui:SymbolIcon x:Name="BannerIcon" Symbol="Wifi124" FontSize="32" VerticalAlignment="Center"/>
                        <ui:TextBlock x:Name="BannerText" Text="Starting..." FontTypography="Title" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <f:SkeletonHost x:Name="BannerSkeleton" Kind="Banner" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="DryBadge" Background="#B45309" CornerRadius="4" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Dry-Run" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                    <Border x:Name="LockBadge" Background="#2563EB" CornerRadius="4" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Locked" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                    <ui:Button x:Name="ModeBtn" Icon="{ui:SymbolIcon ArrowSwap24}" Content="Automatic" Margin="0,0,8,0"/>
                    <ui:Button x:Name="PauseBtn" Icon="{ui:SymbolIcon Pause24}" Content="Pause"/>
                    <ui:Button x:Name="ResumeBtn" Icon="{ui:SymbolIcon Play24}" Content="Resume" Appearance="Success" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

            <!-- the two connections -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="CardP" Grid.Column="0" Style="{StaticResource CardBorder}" ToolTip="Main connection">
                    <Grid MinHeight="104">
                        <StackPanel x:Name="BodyP">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon x:Name="IconP" Symbol="Wifi124" FontSize="18" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ui:TextBlock x:Name="NameP" FontTypography="BodyStrong" Margin="10,0,0,0" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ui:TextBlock x:Name="NetP" HorizontalAlignment="Right" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                            <ui:TextBlock x:Name="BigP" Text="-" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            <ui:TextBlock x:Name="SmallP" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <f:SkeletonHost x:Name="SkelP" Visibility="Collapsed" Margin="0,34,0,0"/>
                    </Grid>
                </Border>
                <Border x:Name="CardB" Grid.Column="2" Style="{StaticResource CardBorder}" ToolTip="Backup connection">
                    <Grid MinHeight="104">
                        <StackPanel x:Name="BodyB">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon x:Name="IconB" Symbol="Phone24" FontSize="18" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ui:TextBlock x:Name="NameB" FontTypography="BodyStrong" Margin="10,0,0,0" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ui:TextBlock x:Name="NetB" HorizontalAlignment="Right" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                            <ui:TextBlock x:Name="BigB" Text="-" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            <ui:TextBlock x:Name="SmallB" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <f:SkeletonHost x:Name="SkelB" Visibility="Collapsed" Margin="0,34,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- blocked now -->
            <Border x:Name="BlockedCard" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="LockClosed24" FontSize="18" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            <ui:TextBlock x:Name="BlockedTitle" Text="Blocked" FontTypography="BodyStrong" Margin="10,0,0,0"/>
                        </StackPanel>
                        <ui:TextBlock Text="Stopped by the watchdog because they downloaded too fast on the backup." Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                        <ui:DataGrid x:Name="BlockedList" SelectionMode="Extended" MaxHeight="150" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False" CanUserResizeRows="False" SelectionUnit="FullRow" RowHeaderWidth="0" Background="Transparent" BorderThickness="0" RowHeight="30" ColumnHeaderHeight="30">
<ui:DataGrid.Columns>
  <DataGridTextColumn Header="Program" Width="*" Binding="{Binding Path}"/>
  <DataGridTextColumn Header="Rule" Width="110" Binding="{Binding Rule}"/>
  <DataGridTextColumn Header="Since" Width="110" Binding="{Binding When}"/>
</ui:DataGrid.Columns>
</ui:DataGrid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" Width="180" VerticalAlignment="Center">
                        <ComboBox x:Name="Grace" SelectedIndex="0" Margin="0,0,0,8" ToolTip="How long to leave the program alone after you unblock it.">
                            <ComboBoxItem Content="10 Min"/><ComboBoxItem Content="30 Min"/><ComboBoxItem Content="1 Hour"/><ComboBoxItem Content="3 Hours"/>
                        </ComboBox>
                        <ui:Button x:Name="UnblockBtn" Content="Unblock" Icon="{ui:SymbolIcon LockOpen24}" Appearance="Success" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                        <ui:Button x:Name="UnblockAllBtn" Content="Unblock All" Icon="{ui:SymbolIcon LockOpen24}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- allowed for now -->
            <Border x:Name="AllowedCard" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Eye24" FontSize="18" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            <ui:TextBlock Text="Allowed For Now" FontTypography="BodyStrong" Margin="10,0,0,0"/>
                        </StackPanel>
                        <ui:TextBlock Text="You unblocked these. The watchdog leaves them alone until the countdown ends." Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                        <ui:DataGrid x:Name="AllowedList" SelectionMode="Extended" MaxHeight="150" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False" CanUserResizeRows="False" SelectionUnit="FullRow" RowHeaderWidth="0" Background="Transparent" BorderThickness="0" RowHeight="30" ColumnHeaderHeight="30">
<ui:DataGrid.Columns>
  <DataGridTextColumn Header="Program" Width="*" Binding="{Binding Path}"/>
  <DataGridTextColumn Header="Rule" Width="110" Binding="{Binding Rule}"/>
  <DataGridTextColumn Header="Watched Again In" Width="110" Binding="{Binding When}"/>
</ui:DataGrid.Columns>
</ui:DataGrid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" Width="180" VerticalAlignment="Center">
                        <ui:Button x:Name="BlockNowBtn" Content="Block Now" Icon="{ui:SymbolIcon LockClosed24}" Appearance="Danger" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                        <ui:Button x:Name="WatchAgainBtn" Content="Watch Again" Icon="{ui:SymbolIcon Eye24}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- latency -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <Grid>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <ui:SymbolIcon Symbol="DataLine24" FontSize="18" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            <ui:TextBlock Text="Latency" FontTypography="BodyStrong" Margin="10,0,0,0"/>
                        </StackPanel>
                        <ui:TextBlock Text="Last ~10 minutes. Red ticks mark failed probes." Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        <f:LatencyChartControl x:Name="Chart" Height="210" Margin="0,4,0,0"/>
                    </StackPanel>
                    <f:SkeletonHost x:Name="SkelChart" Kind="Chart" Visibility="Collapsed" Margin="0,50,0,0"/>
                </Grid>
            </Border>

            <!-- session + backup data -->
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="18" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            <ui:TextBlock Text="Session" FontTypography="BodyStrong" Margin="10,0,0,0"/>
                        </StackPanel>
                        <Grid Margin="0,0,0,12"><ui:SymbolIcon Symbol="ArrowSwap24" FontSize="22" HorizontalAlignment="Left" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Margin="40,0,0,0"><ui:TextBlock x:Name="StSwitches" Text="-" FontSize="22" FontWeight="SemiBold"/><ui:TextBlock Text="Switches" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
                        <Grid Margin="0,0,0,12"><ui:SymbolIcon Symbol="Clock24" FontSize="22" HorizontalAlignment="Left" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Margin="40,0,0,0"><ui:TextBlock x:Name="StOnBackup" Text="-" FontSize="22" FontWeight="SemiBold"/><ui:TextBlock Text="On Backup" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
                        <Grid><ui:SymbolIcon Symbol="Checkmark24" FontSize="22" HorizontalAlignment="Left" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Margin="40,0,0,0"><ui:TextBlock x:Name="StLast" Text="-" FontSize="22" FontWeight="SemiBold"/><ui:TextBlock Text="Last Switch" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="18" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            <ui:TextBlock Text="Backup Data" FontTypography="BodyStrong" Margin="10,0,0,0"/>
                        </StackPanel>
                        <ui:TextBlock TextWrapping="Wrap" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"
                            Text="Data received on the backup this session. Peak = a program's fastest 10 seconds. Set a rule's trigger between a program's idle value and its download peak."/>
                        <ui:DataGrid x:Name="UsageList" SelectionMode="Extended" Height="190" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False" CanUserResizeRows="False" SelectionUnit="FullRow" RowHeaderWidth="0" Background="Transparent" BorderThickness="0" RowHeight="30" ColumnHeaderHeight="30">
<ui:DataGrid.Columns>
  <DataGridTextColumn Header="Program" Width="*" Binding="{Binding Name}"/>
  <DataGridTextColumn Header="Total" Width="110" Binding="{Binding Total}"/>
  <DataGridTextColumn Header="Peak 10 s" Width="110" Binding="{Binding Peak}"/>
  <DataGridTextColumn Header="Watch List" Width="110" Binding="{Binding Watched}"/>
</ui:DataGrid.Columns>
</ui:DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ui:Button x:Name="AddWatchBtn" Content="Add To Watch List" Icon="{ui:SymbolIcon Eye24}" Appearance="Primary"/>
                            <ui:Button x:Name="ResetBtn" Content="Reset" Icon="{ui:SymbolIcon ArrowClockwise24}" Margin="8,0,0,0"/>
                            <ui:TextBlock x:Name="UsageStatus" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
