<Page x:Class="NetworkAutoSwitch.Tray.Fluent.Pages.SettingsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:f="clr-namespace:NetworkAutoSwitch.Tray.Fluent"
        Title="Settings">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,8,32,16" MaxWidth="820" HorizontalAlignment="Stretch">
                <ui:TextBlock Text="Settings" FontTypography="Title" Margin="0,0,0,16"/>

                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon PaintBrush24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock Text="Appearance" FontTypography="BodyStrong"/>
                            <ui:TextBlock Text="Follow System switches with Windows' own light/dark setting." Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox x:Name="ThemeBox" Width="150" SelectedIndex="0">
                        <ComboBoxItem Content="Follow System"/>
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="Dark"/>
                    </ComboBox>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Window24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock Text="Style" FontTypography="BodyStrong"/>
                            <ui:TextBlock TextWrapping="Wrap" Text="Fluent is the Windows 11 look. Classic is the original look. Applies the next time you open the window." Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox x:Name="StyleBox" Width="150" SelectedIndex="1">
                        <ComboBoxItem Content="Classic"/>
                        <ComboBoxItem Content="Fluent"/>
                    </ComboBox>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ArrowSwap24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock Text="Switching Back" FontTypography="BodyStrong"/>
                            <ui:TextBlock TextWrapping="Wrap" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="Seconds the main connection must work, without a single failed check, before moving back from the backup. Going to the backup is not affected."/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <f:Stepper x:Name="RecoverBox" Minimum="3" Maximum="600" Step="1" Decimals="0" Placeholder="Seconds"/>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon AlertOff24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock Text="Mute Notifications" FontTypography="BodyStrong"/>
                            <ui:TextBlock TextWrapping="Wrap" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="Hides the tray pop-ups. Everything is still written to the Log."/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <Grid Width="150"><ui:ToggleSwitch x:Name="MuteSwitch" HorizontalAlignment="Right"/></Grid>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ArrowDownload24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock Text="Global Trigger" FontTypography="BodyStrong"/>
                            <ui:TextBlock TextWrapping="Wrap" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="A watched program that receives more than this many megabytes within 10 seconds on the backup is blocked until you unblock it."/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <f:Stepper x:Name="MbBox" Minimum="0.1" Maximum="10000" Step="0.5" Decimals="1" Placeholder="MB"/>
                </ui:CardControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="32,12" Background="{ui:ThemeResource ControlFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal">
                <ui:Button x:Name="SaveBtn" Content="Save" Appearance="Primary" Icon="{ui:SymbolIcon Save24}"/>
                <ui:Button x:Name="RevertBtn" Content="Revert" Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowUndo24}"/>
                <ui:TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
