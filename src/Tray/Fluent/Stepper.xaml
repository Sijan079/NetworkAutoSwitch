<UserControl x:Class="NetworkAutoSwitch.Tray.Fluent.Stepper"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="150" Height="34">
    <Border CornerRadius="4" BorderThickness="1" Background="{ui:ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ui:Button x:Name="Minus" Grid.Column="0" Width="36" Height="32" Appearance="Transparent" BorderThickness="0" Padding="0" Icon="{ui:SymbolIcon Subtract16}" ToolTip="Less"/>
            <ui:NumberBox x:Name="Box" Grid.Column="1" ClearButtonEnabled="False" SpinButtonPlacementMode="Hidden" Background="Transparent" BorderThickness="0" TextAlignment="Center"/>
            <ui:Button x:Name="Plus" Grid.Column="2" Width="36" Height="32" Appearance="Transparent" BorderThickness="0" Padding="0" Icon="{ui:SymbolIcon Add16}" ToolTip="More"/>
        </Grid>
    </Border>
</UserControl>
