<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>nas-cli</AssemblyName>
    <RootNamespace>NetworkAutoSwitch.Cli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\NetworkAutoSwitch.Core.csproj" />
    <None Include="..\..\config\policy.json" Link="policy.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\config\policy-test.json" Link="policy-test.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
