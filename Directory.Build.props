<Project>
  <!-- ONE place for the version. Everything else (exe file version, window/log text, the installer, the git tag check in CI) reads it from here.
       Rules for changing it: see docs/RELEASING.md. Format: MAJOR.MINOR.PATCH, optionally -prerelease (for example 0.2.0-beta.1). -->
  <PropertyGroup>
    <Version>0.2.0</Version>
    <Product>Network Auto Switch</Product>
    <Authors>Sijan079</Authors>
    <Company>Sijan079</Company>
    <Description>Keeps a main and a backup internet connection and switches between them.</Description>
    <Copyright>Copyright (c) Sijan079</Copyright>
    <RepositoryUrl>https://github.com/Sijan079/NetworkAutoSwitch</RepositoryUrl>
    <!-- the build adds the git commit to the informational version (0.1.0+abc1234), which helps when someone reports a problem -->
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
